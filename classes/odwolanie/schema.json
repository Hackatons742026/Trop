{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trop://classes/odwolanie/schema.json",
  "title": "odwolanie",
  "type": "object",
  "additionalProperties": false,
  "required": ["OdwolanieKIO", "Odwolujacy", "Zamawiajacy", "ZamowieniePubliczne"],
  "properties": {
    "OdwolanieKIO": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "czynnosc_dzien", "czynnosc_powod_id", "czynnosc_opis", "miejscowosc"],
      "properties": {
        "data": {"type": ["string", "null"], "description": "ISO date or null"},
        "czynnosc_dzien": {"type": ["string", "null"], "description": "ISO date or null"},
        "czynnosc_powod_id": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 12,
          "description": "Missing → null (mentor rule)"
        },
        "czynnosc_opis": {"type": ["string", "null"], "description": "Missing → null"},
        "miejscowosc": {"type": ["string", "null"]}
      }
    },
    "Odwolujacy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["krs", "nazwa", "nip", "regon", "przez-pelnomocnika", "pelnomocnik"],
        "properties": {
          "krs": {"type": ["string", "null"]},
          "nazwa": {"type": ["string", "null"]},
          "nip": {"type": ["string", "null"]},
          "regon": {"type": ["string", "null"]},
          "przez-pelnomocnika": {"type": ["integer", "null"], "enum": [0, 1, null]},
          "pelnomocnik": {
            "type": "object",
            "additionalProperties": false,
            "required": ["imie_nazwisko", "nazwa", "mail"],
            "properties": {
              "imie_nazwisko": {"type": ["string", "null"]},
              "nazwa": {"type": ["string", "null"]},
              "mail": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "Zamawiajacy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["krs", "nazwa", "nip", "regon", "prowadzacy_postepowanie"],
        "properties": {
          "krs": {"type": ["string", "null"]},
          "nazwa": {"type": ["string", "null"]},
          "nip": {"type": ["string", "null"]},
          "regon": {"type": ["string", "null"]},
          "prowadzacy_postepowanie": {"type": ["integer", "null"], "enum": [0, 1, null]}
        }
      }
    },
    "ZamowieniePubliczne": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numer_bzp", "numer_postepowania", "numer_ted", "tytul"],
      "properties": {
        "numer_bzp": {"type": ["string", "null"]},
        "numer_postepowania": {"type": ["string", "null"]},
        "numer_ted": {"type": ["string", "null"]},
        "tytul": {"type": ["string", "null"]}
      }
    }
  }
}
