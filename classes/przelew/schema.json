{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trop://classes/przelew/schema.json",
  "title": "przelew",
  "type": "object",
  "additionalProperties": false,
  "required": ["przelew_bankowy"],
  "properties": {
    "przelew_bankowy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_operacji",
        "kwota",
        "na_rachunek",
        "numer_transakcji",
        "tytul",
        "z_rachunku"
      ],
      "properties": {
        "data_operacji": {"type": ["string", "null"], "description": "ISO date or null"},
        "kwota": {"type": ["number", "null"]},
        "na_rachunek": {"type": ["string", "null"], "description": "IBAN/account as printed"},
        "numer_transakcji": {"type": ["string", "null"]},
        "tytul": {"type": ["string", "null"]},
        "z_rachunku": {"type": ["string", "null"], "description": "IBAN/account as printed"}
      }
    }
  }
}
