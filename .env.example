# Copy to .env and adjust as needed.
TROP_INPUT_DIR=input
TROP_OUTPUT_DIR=output
# Evidence sidecars off by default. Uncomment to enable without CLI --evidence:
# TROP_EVIDENCE_DIR=evidence
TROP_CONFIG=config/app.yaml

# Parallel PDF workers (2 vCPU judge VM → 2).
TROP_WORKERS=2

# OCR render DPI (hard-capped by max_dpi).
TROP_DPI=200
TROP_MAX_DPI=250
TROP_MAX_PAGES=40

TROP_LOG_LEVEL=INFO

# Optional LLM assist (nested env via __; disabled by default).
# Profile control: config/llm.yaml → default_profile: none (no LLM = max model-size).
# Set TROP_LLM_CONFIG to override path. Keys never in git.
TROP_LLM_CONFIG=config/llm.yaml
TROP_LLM__ENABLED=false
TROP_LLM__BASE_URL=
TROP_LLM__API_KEY=
TROP_LLM__MODEL=
TROP_LLM__TIMEOUT_S=30
